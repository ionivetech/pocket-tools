{
  "name": "pockettools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "check": "nuxt typecheck",
    "generate:registry": "bun run scripts/generate-tool-registry.ts",
    "scaffold:tool": "bun run scripts/scaffold-tool.ts",
    "lint": "oxlint . --vue-plugin",
    "lint:fix": "oxlint . --vue-plugin --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "test": "bun test tests/unit",
    "test:coverage": "bun test --coverage --coverage-reporter=text tests/unit",
    "test:e2e": "bun run build && playwright test",
    "audit": "bun audit",
    "ci:local": "bun run fmt:check && bun run lint && bun run check && bun run generate:registry -- --check && bun run test:coverage && bun run audit && bun run test && bun run build && playwright test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "@vite-pwa/nuxt": "1.1.1",
    "nuxt": "4.5.2",
    "primevue": "4.5.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "bun-types": "1.4.2",
    "lefthook": "2.1.14",
    "lighthouse": "13.5.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
